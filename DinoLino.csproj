  <PropertyGroup>
    <!-- ClickOnce stages a publish in a folder it empties first, which by default sits
         under the project's own bin. A file-syncing client holds open the files it is
         uploading, and the emptying then fails and stops the build. Staging under the
         machine's own local application data keeps that folder out of reach of anything
         that syncs, and the built program still lands in bin as before. -->
    <PublishDir>$(LOCALAPPDATA)\DinoLino\app.publish\</PublishDir>
    <GenerateManifests>true</GenerateManifests>
    <!-- The signing certificate holds a private key and is kept out of the repository, so
         a machine without it would otherwise fail to build rather than fail to publish.
         Signing is therefore switched on only where the certificate is actually present,
         beside this file; everywhere else the build and the debugger run unsigned. To
         publish from a machine, copy DinoLino_TemporaryKey.pfx into the project folder. -->
    <SignManifests>false</SignManifests>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\DinoLino_TemporaryKey.pfx')">
